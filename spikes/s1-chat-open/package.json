{
  "name": "searchie-s1-probe",
  "displayName": "Searchie S1 Probe (spike)",
  "description": "Throwaway probe: how to open an existing chat session programmatically (see ../S1-open-in-chat.md)",
  "version": "0.0.1",
  "publisher": "searchie-spike",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.106.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "contributes": {
    "commands": [
      { "command": "searchieProbe.c1.vscodeOpen", "title": "S1 C1: vscode.open vscode-chat-session URI", "category": "Searchie Probe" },
      { "command": "searchieProbe.c2a.openSessionInEditorGroup", "title": "S1 C2a: workbench.action.chat.openSessionInEditorGroup { resource }", "category": "Searchie Probe" },
      { "command": "searchieProbe.c2b.openSessionMarshalled", "title": "S1 C2b: openSessionInEditorGroup (marshalled AgentSessionContext)", "category": "Searchie Probe" },
      { "command": "searchieProbe.c2c.switchToSession", "title": "S1 C2c: _chat.voice.switchToSession (Chat view, internal)", "category": "Searchie Probe" },
      { "command": "searchieProbe.c3.historyPicker", "title": "S1 C3: history picker fallback (title to clipboard)", "category": "Searchie Probe" },
      { "command": "searchieProbe.cli1.agentHost", "title": "S1 CLI-1: vscode.open agent-host-copilotcli:/<id>", "category": "Searchie Probe" },
      { "command": "searchieProbe.cli2.extHost", "title": "S1 CLI-2: vscode.open copilotcli:/<id>", "category": "Searchie Probe" },
      { "command": "searchieProbe.env", "title": "S1: dump chat commands + runtime (node:sqlite)", "category": "Searchie Probe" }
    ]
  }
}
